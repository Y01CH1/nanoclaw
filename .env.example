# Preferred Codex runtime credential priority:
# 1) CODEX_API_KEY
# 2) OPENAI_API_KEY
# 3) data/sessions/<group>/.codex/auth.json (auto-seeded from ~/.codex/auth.json)
# Note: ANTHROPIC_* and CLAUDE_CODE_* are Claude rollback credentials only.

CODEX_API_KEY=
OPENAI_API_KEY=

# Deprecated fallback credentials (kept during rollback window)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=

ASSISTANT_NAME=Andy
ASSISTANT_HAS_OWN_NUMBER=false
